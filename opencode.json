{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openrouter", "deepseek"],
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-pro": {
          "options": {
            "provider": {
              "only": ["deepseek"]
            }
          }
        }
      }
    }
  },
  "model": "deepseek/deepseek-v4-pro",
  "instructions": [
    "README.md",
    "CONTRIBUTING.md",
    "flake.nix",
    "docs/**/*.md",
    "src/lib/**/*.nix",
    "src/overlays/**/*.nix",
    "src/meta/**/*.nix",
    "src/dev/**/*.nix",
    "src/dev/**/*.nu",
    "src/test/**/*.nix",
    "src/cli/**/*.nix",
    "src/cli/**/*.nu"
  ]
}
